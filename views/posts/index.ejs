<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Blog Platform</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-4">
    <%- include('../partials/flash') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-newspaper"></i> All Posts</h1>
      <% if (currentUser) { %>
        <a href="/posts/new" class="btn btn-primary">
          <i class="bi bi-plus-circle"></i> New Post
        </a>
      <% } %>
    </div>

    <!-- Search and Sort -->
    <div class="row mb-4">
      <div class="col-md-8">
        <form action="/posts" method="GET" class="d-flex gap-2">
          <input type="text" class="form-control" name="search" 
                 placeholder="Search posts..." value="<%= search %>">
          <button class="btn btn-primary" type="submit">
            <i class="bi bi-search"></i> Search
          </button>
        </form>
      </div>
      <div class="col-md-4">
        <form action="/posts" method="GET">
          <input type="hidden" name="search" value="<%= search %>">
          <select class="form-select" name="sort" onchange="this.form.submit()">
            <option value="-createdAt" <%= sort === '-createdAt' ? 'selected' : '' %>>Newest First</option>
            <option value="createdAt" <%= sort === 'createdAt' ? 'selected' : '' %>>Oldest First</option>
            <option value="title" <%= sort === 'title' ? 'selected' : '' %>>Title A-Z</option>
            <option value="-title" <%= sort === '-title' ? 'selected' : '' %>>Title Z-A</option>
            <option value="-views" <%= sort === '-views' ? 'selected' : '' %>>Most Viewed</option>
          </select>
        </form>
      </div>
    </div>

    <% if (posts.length === 0) { %>
      <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No posts found. Be the first to create one!
      </div>
    <% } else { %>
      <div class="row">
        <% posts.forEach(post => { %>
          <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm hover-card">
              <% if (post.image) { %>
                <img src="<%= post.image %>" class="card-img-top" alt="<%= post.title %>" 
                     style="height: 250px; object-fit: cover;">
              <% } %>
              <div class="card-body">
                <h5 class="card-title">
                  <a href="/posts/<%= post.slug %>" class="text-decoration-none text-dark">
                    <%= post.title %>
                  </a>
                </h5>
                <p class="card-text text-muted">
                  <%= post.content.substring(0, 150) %>...
                </p>
                <div class="mb-2">
                  <% post.tags.forEach(tag => { %>
                    <span class="badge bg-secondary me-1"><%= tag %></span>
                  <% }) %>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-muted">
                    <i class="bi bi-person"></i> <%= post.author.username %>
                  </small>
                  <div>
                    <small class="text-muted me-2">
                      <i class="bi bi-eye"></i> <%= post.views %>
                    </small>
                    <small class="text-muted">
                      <i class="bi bi-calendar"></i> <%= new Date(post.createdAt).toLocaleDateString() %>
                    </small>
                  </div>
                </div>
              </div>
              <div class="card-footer bg-transparent">
                <a href="/posts/<%= post.slug %>" class="btn btn-sm btn-outline-primary">
                  Read More <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (totalPages > 1) { %>
        <nav aria-label="Page navigation">
          <ul class="pagination justify-content-center">
            <li class="page-item <%= currentPage === 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= currentPage - 1 %>&sort=<%= sort %>&search=<%= search %>">
                Previous
              </a>
            </li>
            
            <% for(let i = 1; i <= totalPages; i++) { %>
              <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                <a class="page-link" href="?page=<%= i %>&sort=<%= sort %>&search=<%= search %>">
                  <%= i %>
                </a>
              </li>
            <% } %>
            
            <li class="page-item <%= currentPage === totalPages ? 'disabled' : '' %>">
              <a class="page-link" href="?page=<%= currentPage + 1 %>&sort=<%= sort %>&search=<%= search %>">
                Next
              </a>
            </li>
          </ul>
        </nav>
      <% } %>
    <% } %>
  </div>

  <footer class="bg-dark text-white text-center py-3 mt-5">
    <div class="container">
      <p class="mb-0">&copy; 2025 Blog Platform. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>