<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Blog Platform</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-4">
    <%- include('../partials/flash') %>

    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1><i class="bi bi-newspaper"></i> All Posts</h1>
      <% if (currentUser) { %>
        <a href="/posts/new" class="btn btn-primary">
          <i class="bi bi-plus-circle"></i> New Post
        </a>
      <% } %>
    </div>

    <% if (posts.length === 0) { %>
      <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> No posts yet. Be the first to create one!
      </div>
    <% } else { %>
      <div class="row">
        <% posts.forEach(post => { %>
          <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm hover-card">
              <div class="card-body">
                <h5 class="card-title">
                  <a href="/posts/<%= post._id %>" class="text-decoration-none text-dark">
                    <%= post.title %>
                  </a>
                </h5>
                <p class="card-text text-muted">
                  <%= post.content.substring(0, 150) %>...
                </p>
                <div class="mb-2">
                  <% post.tags.forEach(tag => { %>
                    <span class="badge bg-secondary me-1"><%= tag %></span>
                  <% }) %>
                </div>
                <div class="d-flex justify-content-between align-items-center">
                  <small class="text-muted">
                    <i class="bi bi-person"></i> <%= post.author.username %>
                  </small>
                  <small class="text-muted">
                    <i class="bi bi-calendar"></i> <%= new Date(post.createdAt).toLocaleDateString() %>
                  </small>
                </div>
              </div>
              <div class="card-footer bg-transparent">
                <a href="/posts/<%= post._id %>" class="btn btn-sm btn-outline-primary">
                  Read More <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>

  <footer class="bg-dark text-white text-center py-3 mt-5">
    <div class="container">
      <p class="mb-0">&copy; 2025 Blog Platform. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>