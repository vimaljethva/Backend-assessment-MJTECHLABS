<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - Blog Platform</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/navbar') %>

  <div class="container mt-4">
    <%- include('../partials/flash') %>

    <div class="row">
      <div class="col-lg-8">
        <article class="card shadow mb-4">
          <div class="card-body">
            <h1 class="mb-3"><%= post.title %></h1>
            
            <div class="mb-3">
              <% post.tags.forEach(tag => { %>
                <span class="badge bg-secondary me-1"><%= tag %></span>
              <% }) %>
              <span class="badge bg-<%= post.status === 'published' ? 'success' : 'warning' %>">
                <%= post.status %>
              </span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
              <div>
                <i class="bi bi-person-circle"></i> <strong><%= post.author.username %></strong>
              </div>
              <div class="text-muted">
                <i class="bi bi-calendar"></i> <%= new Date(post.createdAt).toLocaleDateString() %>
              </div>
            </div>

            <div class="post-content">
              <%= post.content %>
            </div>

            <% if (currentUser && post.author._id.equals(currentUser._id)) { %>
              <div class="mt-4 pt-3 border-top">
                <a href="/posts/<%= post._id %>/edit" class="btn btn-warning me-2">
                  <i class="bi bi-pencil"></i> Edit
                </a>
                <form action="/posts/<%= post._id %>?_method=DELETE" method="POST" class="d-inline">
                  <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this post?')">
                    <i class="bi bi-trash"></i> Delete
                  </button>
                </form>
              </div>
            <% } %>
          </div>
        </article>

        <!-- Comments Section -->
        <div class="card shadow">
          <div class="card-body">
            <h3 class="mb-4"><i class="bi bi-chat-dots"></i> Comments</h3>

            <% if (currentUser) { %>
              <form action="/posts/<%= post._id %>/comments" method="POST" class="mb-4">
                <div class="mb-3">
                  <textarea name="content" class="form-control" rows="3" placeholder="Write a comment..." required maxlength="1000"></textarea>
                </div>
                <button type="submit" class="btn btn-primary">
                  <i class="bi bi-send"></i> Post Comment
                </button>
              </form>
            <% } else { %>
              <div class="alert alert-info">
                <a href="/auth/login">Login</a> to leave a comment
              </div>
            <% } %>

            <!-- Display Comments -->
            <% if (comments.length === 0) { %>
              <p class="text-muted">No comments yet. Be the first to comment!</p>
            <% } else { %>
              <% comments.forEach(comment => { %>
                <div class="comment mb-3 p-3 border rounded">
                  <div class="d-flex justify-content-between mb-2">
                    <strong><i class="bi bi-person-circle"></i> <%= comment.author.username %></strong>
                    <small class="text-muted"><%= new Date(comment.createdAt).toLocaleString() %></small>
                  </div>
                  <p class="mb-2"><%= comment.content %></p>
                  
                  <div class="d-flex gap-2">
                    <% if (currentUser) { %>
                      <button class="btn btn-sm btn-outline-primary reply-btn" data-comment-id="<%= comment._id %>">
                        <i class="bi bi-reply"></i> Reply
                      </button>
                    <% } %>
                    
                    <% if (currentUser && comment.author._id.equals(currentUser._id)) { %>
                      <form action="/posts/<%= post._id %>/comments/<%= comment._id %>?_method=DELETE" method="POST" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this comment?')">
                          <i class="bi bi-trash"></i> Delete
                        </button>
                      </form>
                    <% } %>
                  </div>

                  <!-- Reply Form (Hidden by default) -->
                  <% if (currentUser) { %>
                    <div class="reply-form mt-3" id="reply-form-<%= comment._id %>" style="display: none;">
                      <form action="/posts/<%= post._id %>/comments/<%= comment._id %>/reply" method="POST">
                        <div class="mb-2">
                          <textarea name="content" class="form-control" rows="2" placeholder="Write a reply..." required maxlength="1000"></textarea>
                        </div>
                        <button type="submit" class="btn btn-sm btn-primary">
                          <i class="bi bi-send"></i> Reply
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary cancel-reply" data-comment-id="<%= comment._id %>">
                          Cancel
                        </button>
                      </form>
                    </div>
                  <% } %>

                  <!-- Display Replies -->
                  <% if (comment.replies && comment.replies.length > 0) { %>
                    <div class="replies ms-4 mt-3">
                      <% comment.replies.forEach(reply => { %>
                        <div class="reply mb-2 p-2 border-start border-primary border-3 ps-3">
                          <div class="d-flex justify-content-between mb-1">
                            <small><strong><i class="bi bi-person-circle"></i> <%= reply.author.username %></strong></small>
                            <small class="text-muted"><%= new Date(reply.createdAt).toLocaleString() %></small>
                          </div>
                          <p class="mb-1 small"><%= reply.content %></p>
                          
                          <% if (currentUser && reply.author._id.equals(currentUser._id)) { %>
                            <form action="/posts/<%= post._id %>/comments/<%= reply._id %>?_method=DELETE" method="POST" class="d-inline">
                              <button type="submit" class="btn btn-sm btn-outline-danger btn-sm" onclick="return confirm('Delete this reply?')">
                                <i class="bi bi-trash"></i> Delete
                              </button>
                            </form>
                          <% } %>
                        </div>
                      <% }) %>
                    </div>
                  <% } %>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="card shadow mb-3">
          <div class="card-body">
            <h5 class="card-title">About this post</h5>
            <p class="card-text">
              <strong>Author:</strong> <%= post.author.username %><br>
              <strong>Created:</strong> <%= new Date(post.createdAt).toLocaleDateString() %><br>
              <strong>Status:</strong> <%= post.status %><br>
              <strong>Tags:</strong> <%= post.tags.join(', ') || 'None' %>
            </p>
          </div>
        </div>
        
        <div class="card shadow">
          <div class="card-body">
            <h5 class="card-title">Actions</h5>
            <a href="/posts" class="btn btn-outline-primary w-100 mb-2">
              <i class="bi bi-arrow-left"></i> Back to Posts
            </a>
            <% if (currentUser) { %>
              <a href="/posts/new" class="btn btn-outline-success w-100">
                <i class="bi bi-plus-circle"></i> New Post
              </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>

  <footer class="bg-dark text-white text-center py-3 mt-5">
    <div class="container">
      <p class="mb-0">&copy; 2025 Blog Platform. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/script.js"></script>
</body>
</html>