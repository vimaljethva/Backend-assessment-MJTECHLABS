<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Blog Platform</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="hero-section">
    <div class="container text-center">
      <h1 class="display-3 fw-bold mb-4">Welcome to Blog Platform</h1>
      <p class="lead mb-4">Share your thoughts, ideas, and stories with the world</p>
      
      <!-- Search Bar -->
      <div class="row justify-content-center mb-4">
        <div class="col-md-6">
          <form action="/" method="GET" class="search-form">
            <div class="input-group input-group-lg">
              <input type="text" class="form-control" name="search" 
                     placeholder="Search posts..." value="<%= search %>">
              <button class="btn btn-light" type="submit">
                <i class="bi bi-search"></i> Search
              </button>
            </div>
          </form>
        </div>
      </div>

      <div class="d-grid gap-2 d-md-flex justify-content-md-center">
        <% if (currentUser) { %>
          <a href="/posts" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-book"></i> Browse Posts
          </a>
          <a href="/posts/new" class="btn btn-outline-light btn-lg px-4">
            <i class="bi bi-plus-circle"></i> Create Post
          </a>
        <% } else { %>
          <a href="/auth/register" class="btn btn-primary btn-lg px-4">Get Started</a>
          <a href="/posts" class="btn btn-outline-light btn-lg px-4">Browse Posts</a>
        <% } %>
      </div>
    </div>
  </div>

  <div class="container my-5">
    <%- include('partials/flash') %>
    
    <div class="row g-4 text-center mb-5">
      <div class="col-md-4">
        <div class="feature-card p-4">
          <i class="bi bi-pencil-square feature-icon"></i>
          <h3>Write & Share</h3>
          <p>Create beautiful blog posts with rich content and images</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card p-4">
          <i class="bi bi-chat-dots feature-icon"></i>
          <h3>Engage</h3>
          <p>Comment, like, and discuss with the community</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card p-4">
          <i class="bi bi-shield-check feature-icon"></i>
          <h3>Secure</h3>
          <p>Your data is protected with JWT authentication</p>
        </div>
      </div>
    </div>

    <!-- Recent Posts -->
    <% if (recentPosts && recentPosts.length > 0) { %>
      <div class="recent-posts">
        <h2 class="text-center mb-4">Recent Posts</h2>
        <div class="row g-4">
          <% recentPosts.forEach(post => { %>
            <div class="col-md-4">
              <div class="card h-100 shadow-sm hover-card">
                <% if (post.image) { %>
                  <img src="<%= post.image %>" class="card-img-top" alt="<%= post.title %>" style="height: 200px; object-fit: cover;">
                <% } %>
                <div class="card-body">
                  <h5 class="card-title">
                    <a href="/posts/<%= post.slug %>" class="text-decoration-none text-dark">
                      <%= post.title %>
                    </a>
                  </h5>
                  <p class="card-text text-muted">
                    <%= post.content.substring(0, 100) %>...
                  </p>
                  <div class="d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                      <i class="bi bi-person"></i> <%= post.author.username %>
                    </small>
                    <small class="text-muted">
                      <i class="bi bi-eye"></i> <%= post.views %>
                    </small>
                  </div>
                </div>
                <div class="card-footer bg-transparent">
                  <a href="/posts/<%= post.slug %>" class="btn btn-sm btn-outline-primary">
                    Read More <i class="bi bi-arrow-right"></i>
                  </a>
                </div>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="text-center mt-4">
          <a href="/posts" class="btn btn-primary">View All Posts</a>
        </div>
      </div>
    <% } %>
  </div>

  <footer class="bg-dark text-white text-center py-3 mt-5">
    <div class="container">
      <p class="mb-0">&copy; 2025 Blog Platform. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>