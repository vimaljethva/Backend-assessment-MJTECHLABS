<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Home - Blog Platform</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="hero-section">
    <div class="container text-center">
      <h1 class="display-3 fw-bold mb-4">Welcome to Blog Platform</h1>
      <p class="lead mb-4">Share your thoughts, ideas, and stories with the world</p>
      <div class="d-grid gap-2 d-md-flex justify-content-md-center">
        <% if (currentUser) { %>
          <a href="/posts" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-book"></i> Browse Posts
          </a>
          <a href="/posts/new" class="btn btn-outline-light btn-lg px-4">
            <i class="bi bi-plus-circle"></i> Create Post
          </a>
        <% } else { %>
          <a href="/auth/register" class="btn btn-primary btn-lg px-4">Get Started</a>
          <a href="/posts" class="btn btn-outline-light btn-lg px-4">Browse Posts</a>
        <% } %>
      </div>
    </div>
  </div>

  <div class="container my-5">
    <%- include('partials/flash') %>
    
    <div class="row g-4 text-center">
      <div class="col-md-4">
        <div class="feature-card p-4">
          <i class="bi bi-pencil-square feature-icon"></i>
          <h3>Write & Share</h3>
          <p>Create beautiful blog posts with rich content and share with the community</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card p-4">
          <i class="bi bi-chat-dots feature-icon"></i>
          <h3>Engage</h3>
          <p>Comment on posts and engage in meaningful discussions with nested replies</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="feature-card p-4">
          <i class="bi bi-shield-check feature-icon"></i>
          <h3>Secure</h3>
          <p>Your data is protected with JWT authentication and secure practices</p>
        </div>
      </div>
    </div>
  </div>

  <footer class="bg-dark text-white text-center py-3 mt-5">
    <div class="container">
      <p class="mb-0">&copy; 205 Blog Platform. All rights reserved.</p>
    </div>
  </footer>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>