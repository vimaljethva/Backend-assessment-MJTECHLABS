<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Error - Blog Platform</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/navbar') %>

  <div class="container mt-5">
    <div class="row justify-content-center">
      <div class="col-md-8 text-center">
        <div class="card shadow">
          <div class="card-body p-5">
            <h1 class="display-1 text-danger"><%= error.statusCode || 500 %></h1>
            <h2 class="mb-4">Oops! Something went wrong</h2>
            <p class="lead"><%= error.message || 'An unexpected error occurred' %></p>
            <a href="/" class="btn btn-primary mt-3">Go Home</a>
            <a href="/posts" class="btn btn-outline-primary mt-3">Browse Posts</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>